# helpers/eink_image.py writes LF. Without this, core.autocrlf=true checks the
# generated header out as CRLF and every regeneration shows a whole-file diff.
helpers/eink_image.py text eol=lf
src/Display/EInk/Images/*.h text eol=lf
# Byte-exact goldens: never convert line ends (core.autocrlf is on).
test/fixtures/*.txt -text
# web/ is gzipped into the firmware; LF keeps the generated bytes checkout-independent.
web/** text eol=lf
